# Velocity passes PORT if you set it in the dashboard; the platform default is 3000.
# Locally the dashboard uses 3000, so the API runs on 4000.
PORT=4000

# Local database from docker-compose.yml at the repo root.
# Not needed on Velocity: attaching PostgreSQL to the app injects PGHOST, PGPORT, PGDATABASE,
# PGUSER and PGPASSWORD, and the API uses those when DATABASE_URL is absent.
DATABASE_URL=postgres://appdashboard:appdashboard@127.0.0.1:5432/appdashboard

# Shared secret between the dashboard server and the API. At least 32 characters.
# Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
