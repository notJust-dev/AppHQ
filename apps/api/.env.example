# Velocity passes PORT if you set it in the dashboard; the platform default is 3000.
# Locally the dashboard uses 3000, so the API runs on 4000.
PORT=4000

# Local database from docker-compose.yml at the repo root.
# Not needed on Velocity: attaching PostgreSQL to the app injects PGHOST, PGPORT, PGDATABASE,
# PGUSER and PGPASSWORD, and the API uses those when DATABASE_URL is absent.
DATABASE_URL=postgres://appdashboard:appdashboard@127.0.0.1:5432/appdashboard

# Shared secret between the dashboard server and the API. At least 32 characters.
# Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Encrypts API keys and OAuth tokens stored in the database. 64 hex characters.
# Generate one with: openssl rand -hex 32
# Changing it makes every stored credential unreadable, so sources have to be reconnected.
ENCRYPTION_KEY=

# Hours between the syncs the API starts by itself. 0 turns them off. Default 3.
# SYNC_EVERY_HOURS=3

# Whether this API accepts the web app's dashboard password (DASHBOARD_PASSWORD there): true or
# false, default true. Set false once you sign in with an approved account instead; the password
# then opens nothing, even if it is still set on the web app. Do it after checking that your
# account opens the dashboard. See "Turning the dashboard password off" in the README.
# ALLOW_DASHBOARD_PASSWORD=true

# Optional sources, each set up as the README describes. Without them, their pages say so.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# A Google OAuth client (Web application) for YouTube.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: accounts, so people can sign in with Google or GitHub, or sign up with an email
# address, and ask for access. Off unless the secret, PUBLIC_URL and at least one way to sign in
# (Google, GitHub or the mail server below) are set. An approved account opens the dashboard in
# the organization it belongs to. See the README.
# Generate the secret with: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# The dashboard's address (the web app, not this API), with no path. Same as PUBLIC_URL on the
# web app.
# PUBLIC_URL=http://127.0.0.1:3000
# Redirect URI to register: <PUBLIC_URL>/api/auth/callback/google
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# Callback URL to register: <PUBLIC_URL>/api/auth/callback/github
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Optional: signing up with an email address and a password. Needs accounts (the secret and
# PUBLIC_URL above) and a mail server, for the confirmation code and the password reset link.
# Any provider's SMTP server works. See "Signing up with an email address" in the README.
# SMTP_HOST=smtp.example.com
# Default 465.
# SMTP_PORT=465
# implicit (TLS from the start, port 465), starttls (port 587) or none. Default: by the port.
# none is refused unless SMTP_HOST is this machine, as for a local mail catcher.
# SMTP_TLS=implicit
# SMTP_USER=
# SMTP_PASSWORD=
# The sender, on a domain you verified with the mail provider.
# MAIL_FROM=AppHQ <no-reply@apphq.example.com>
# Where replies go, when that is not the sender.
# MAIL_REPLY_TO=

# Optional: error reporting with Sentry, or anything that speaks its protocol (GlitchTip, a
# self-hosted Sentry). Off unless set. See "Error reporting" in the README for what is sent.
# SENTRY_DSN=https://<key>@<your-sentry-host>/<project-id>
# The environment errors are filed under. Default: NODE_ENV.
# SENTRY_ENVIRONMENT=production
