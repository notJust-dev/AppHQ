{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  // Compile what the entry points import, not every file under src: Velocity's deploy keeps
  // files that were deleted from the repository, and a stale one must not fail the build.
  "files": ["src/server.ts", "src/cli.ts"],
  "include": []
}
