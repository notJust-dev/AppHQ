# Where the dashboard server reaches the API. On Velocity this is the API app's public URL.
API_URL=http://127.0.0.1:4000

# Same value as INTERNAL_API_TOKEN in apps/api.
INTERNAL_API_TOKEN=

# Encrypts the session cookie. At least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# The dashboard password. At least 12 characters. Changing it signs out everyone who signed in
# with it. Optional once accounts (set up on the API) are on: leave it empty
# and the password is off, so only approved accounts open the dashboard. Turn it off only after
# your account opens your data; see "Turning the dashboard password off" in the README.
DASHBOARD_PASSWORD=

# Optional. The dashboard's public address, used for the TikTok, Meta and YouTube sign-in
# redirect URIs. Without it they come from the address the dashboard was opened at.
# Set it once you add a custom domain, e.g. https://apphq.example.com
# PUBLIC_URL=

# Optional. Product analytics with PostHog, off unless set. Cookieless, with page text masked;
# events go through this server's /ingest path. Use the project API key (starts with phc_).
# POSTHOG_KEY=
# Optional. Defaults to PostHog's US cloud. For the EU cloud: https://eu.i.posthog.com
# POSTHOG_HOST=

# Optional. Error reporting from the browser with Sentry, or anything that speaks its protocol
# (GlitchTip, a self-hosted Sentry). Off unless set. See "Error reporting" in the README.
# SENTRY_DSN=https://<key>@<your-sentry-host>/<project-id>
# Optional. The environment errors are filed under. Default: NODE_ENV.
# SENTRY_ENVIRONMENT=production
